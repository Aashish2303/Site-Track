APP_NAME="SiteTrack Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sitetrack.pro
CORS_ALLOWED_ORIGINS=https://sitetrack.pro

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Set DATABASE_URL or the DB_* connection fields. Never commit real values.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
MYSQL_ATTR_SSL_CA=

BROADCAST_DRIVER=null
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# SMTP can instead be configured through the protected application Settings.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
